{
  "info": {
    "name": "Unified Organization Workspace API Collection",
    "description": "Production Postman API Collection for Unified Organization Workspace platform covering Auth, Organizations, Tickets, PRs, Audit, Collaboration, Digest, Notifications, Health, Security, and Feature Flags.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "orgId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health & System Monitoring",
      "item": [
        {
          "name": "Get System Health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:4000/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["health"]
            }
          }
        },
        {
          "name": "Get Readiness Status",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:4000/ready",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["ready"]
            }
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Admin User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"Admin\",\n  \"email\": \"admin@workspace.com\",\n  \"password\": \"Password123!\",\n  \"organizationName\": \"Alpha Workspace\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "User Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@workspace.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Support Hub Tickets",
      "item": [
        {
          "name": "List Tickets",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "X-Organization-Id", "value": "{{orgId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/tickets?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["tickets"]
            }
          }
        },
        {
          "name": "Create Support Ticket",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "X-Organization-Id", "value": "{{orgId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman API Integration Ticket\",\n  \"description\": \"Testing ticket submission via Postman Collection\",\n  \"category\": \"TECHNICAL\",\n  \"priority\": \"HIGH\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["tickets"]
            }
          }
        }
      ]
    },
    {
      "name": "Security & Feature Flags",
      "item": [
        {
          "name": "List Active Sessions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/security/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["security", "sessions"]
            }
          }
        },
        {
          "name": "List Feature Flags",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "X-Organization-Id", "value": "{{orgId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/feature-flags",
              "host": ["{{baseUrl}}"],
              "path": ["feature-flags"]
            }
          }
        }
      ]
    }
  ]
}
