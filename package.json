{
  "name": "unified-app",
  "version": "0.1.0",
  "private": true,
  "description": "Unified Enterprise Next.js 15 Application",
  "scripts": {
    "dev": "next dev",
    "build": "npx prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "SKIP_RATE_LIMIT=true npx tsx tests/testRunner.ts",
    "worker": "npx tsx src/workers/index.ts",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "seed": "npx tsx prisma/seed.ts",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:reset": "npx tsx prisma/reset.ts",
    "seed:demo": "npx tsx prisma/seed.ts",
    "seed:reset": "ts-node prisma/reset.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky install || true"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
