    "compression": "^1.7.4",
    "cookie": "^0.6.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "framer-motion": "^12.42.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.378.0",
    "multer": "^2.2.0",
    "next": "^15.0.0",
    "next-themes": "^0.3.0",
    "pino": "^8.20.0",
    "pino-http": "^9.0.0",
    "prisma": "^5.14.0",
    "react": "^19.0.0-rc-6925828f-20241021",
    "react-dom": "^19.0.0-rc-6925828f-20241021",
    "tailwind-merge": "^2.3.0",
    "typescript": "^5.4.5",
    "zod": "^3.23.8"
