# Production Environment Configuration Template
NODE_ENV=production
PORT=4000

# Client Application URL
CLIENT_URL=https://workspace.yourdomain.com
NEXT_PUBLIC_API_URL=https://workspace.yourdomain.com/api/v1

# PostgreSQL Connection String
DATABASE_URL=postgresql://prod_workspace_user:prod_secure_password_change_me@postgres:5432/prod_workspace_db?schema=public

# Redis Connection String
REDIS_URL=redis://redis:6379

# Cryptographic & Session Secrets (Must be min 32 characters in production)
JWT_SECRET=production-super-secret-jwt-key-min-32-characters-long
JWT_REFRESH_SECRET=production-super-secret-refresh-key-min-32-characters-long

# Gemini AI Key (Optional)
GEMINI_API_KEY=your-production-gemini-api-key-here
