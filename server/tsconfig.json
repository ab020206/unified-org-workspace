{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "..",
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@workspace/shared-types": ["../packages/shared-types/src/index.ts"],
      "@workspace/shared-utils": ["../packages/shared-utils/src/index.ts"]
    }
  },
  "include": ["src/**/*", "prisma/**/*", "../packages/**/*"]
}
